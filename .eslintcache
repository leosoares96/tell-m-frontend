on.search'. Either include it or remove the dependency array.",["407"],"React Hook useEffect has a missing dependency: 'props.match.params'. Either include it or remove the dependency array.",["408"],"no-unreachable","Unreachable code.","BreakStatement","unreachableCode","jsx-a11y/aria-role","Elements with ARIA roles must use a valid, non-abstract ARIA role.","JSXAttribute","'NavLink' is defined but never used.","'useHistory' is defined but never used.","'swal' is defined but never used.","'retornaUsuarioLogado' is defined but never used.","React Hook useEffect has a missing dependency: 'getData'. Either include it or remove the dependency array.",["409"],"React Hook useEffect has a missing dependency: 'buscarOperacoes'. Either include it or remove the dependency array.",["410"],["403"],["404"],"'PrivateRoute' is assigned a value but never used.","no-global-assign","no-unsafe-negation",{"desc":"411","fix":"412"},{"desc":"413","fix":"414"},{"desc":"415","fix":"416"},{"desc":"417","fix":"418"},{"desc":"419","fix":"420"},{"desc":"421","fix":"422"},"Update the dependencies array to be: [dataChart, dataChartSelected, emptyDataChart]",{"range":"423","text":"424"},"Update the dependencies array to be: [history]",{"range":"425","text":"426"},"Update the dependencies array to be: [location.search]",{"range":"427","text":"428"},"Update the dependencies array to be: [props.match.params]",{"range":"429","text":"430"},"Update the dependencies array to be: [getData]",{"range":"431","text":"432"},"Update the dependencies array to be: [buscarOperacoes]",{"range":"433","text":"434"},[1722,1752],"[dataChart, dataChartSelected, emptyDataChart]",[1515,1517],"[history]",[1052,1054],"[location.search]",[1106,1108],"[props.match.params]",[4042,4044],"[getData]",[715,717],"[buscarOperacoes]"]
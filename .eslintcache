ingCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"268"},{"filePath":"269","messages":"270","errorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":null},{"filePath":"271","messages":"272","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0},{"filePath":"273","messages":"274","errorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":null},"D:\\dev\\02. VORTEXPRO\\vortexpro\\app\\src\\routes.tsx",["275"],"import React from 'react';\r\nimport { verificaAutenticacao } from './services/usuario';\r\nimport { Route, BrowserRouter, Switch, Redirect } from 'react-router-dom';\r\n\r\nimport Login from './pages/Login';\r\nimport RecuperSenha from './pages/RecuperarSenha';\r\nimport ResetarSenha from './pages/ResetarSenha';\r\nimport Cadastro from './pages/Cadastro';\r\nimport CadastroOperacao from './pages/CadastroOperacao';\r\n\r\nimport Home from './pages/Home';\r\nimport Perfil from './pages/Perfil';\r\nimport Controle from './pages/ImportarDados';\r\nimport Dashboard from './pages/Dashboard';\r\nimport Simulador from './pages/Simulador';\r\nimport Administracao from './pages/Administracao'\r\nimport ExcluirConta from './pages/ExcluirConta'\r\nimport Orientacao from './pages/Orientacao'\r\n\r\nconst PrivateRoute = ({ component: Component, ...rest }: any) => {\r\n  return (\r\n    <Route\r\n      {...rest}\r\n      render={(props) =>\r\n        verificaAutenticacao() ? (\r\n          <Component {...props} />\r\n        ) : (\r\n            <Redirect to={{ pathname: '/', state: { from: props.location } }} />\r\n          )\r\n      }\r\n    />\r\n  );\r\n};\r\nconst PublicRoute = ({ component: Component, ...rest }: any) => {\r\n  return (\r\n    <Route\r\n      {...rest}\r\n      render={(props) =>\r\n        verificaAutenticacao() ? (\r\n          <Redirect to={{ pathname: '/Home', state: { from: props.location } }} />\r\n        ) : (\r\n            <Component {...props} />\r\n          )\r\n      }\r\n    />\r\n  );\r\n};\r\nconst Routes = () => {\r\n  return (\r\n    <BrowserRouter basename=\"/\">\r\n      <Switch>\r\n        <PublicRoute component={Login} path=\"/\" exact />\r\n        <PublicRoute component={Login} path=\"/Login\" exact />\r\n        <PublicRoute component={RecuperSenha} path=\"/RecuperarSenha\" exact />\r\n        <PublicRoute component={ResetarSenha} path=\"/ResetarSenha\" exact />\r\n        <PublicRoute component={Cadastro} path=\"/Cadastro\" exact />\r\n        <Route component={CadastroOperacao} path=\"/CadastroOperacao\" exact />\r\n\r\n        <PrivateRoute component={Home} path=\"/Home\" exact />\r\n        <PrivateRoute component={Perfil} path=\"/Perfil\" exact />\r\n        <PrivateRoute component={ExcluirConta} path=\"/ExcluirConta\" exact />\r\n        <PrivateRoute component={Dashboard} path=\"/Dashboard\" exact />\r\n        <PrivateRoute component={Simulador} path=\"/Simulador\" exact />\r\n        <PrivateRoute component={Administracao} path=\"/Administracao\" exact />\r\n\r\n        <Route component={Orientacao} path=\"/Orientacao/:id\" exact />\r\n      </Switch>\r\n    </BrowserRouter>\r\n  );\r\n};\r\n\r\nexport default Routes;\r\n",["276","277"],"D:\\dev\\02. VORTEXPRO\\vortexpro\\app\\src\\pages\\RecuperarSenha\\index.tsx",[],["278","279"],"D:\\dev\\02. VORTEXPRO\\vortexpro\\app\\src\\pages\\CadastroOperacao\\index.tsx",["280","281"],"import React, { useState, useEffect, ChangeEvent } from 'react';\r\nimport { NavLink, useHistory } from 'react-router-dom';\r\nimport Alert from '../../helpers/Alert';\r\n\r\nimport { BoxCenter } from '../../assets/styles/boxCenter';\r\nimport Logo from '../../assets/images/logo.png';\r\nimport Input from '../../components/Form/Input';\r\n\r\nimport { ativarUsuario, retornaUsuario } from '../../services/usuario';\r\nimport { cadastrarOperacao } from '../../services/operacao';\r\nimport { FaQuestionCircle } from 'react-icons/fa';\r\n\r\ninterface TypeData {\r\n  operacao: string;\r\n  celula_1: string;\r\n  celula_2: string;\r\n}\r\n\r\nconst Cadastro = ({ location }: any) => {\r\n  let history = useHistory();\r\n\r\n  const [data, setData] = useState<TypeData>({\r\n    operacao: '',\r\n    celula_1: '',\r\n    celula_2: '',\r\n  });\r\n\r\n  const handleInputChange = (event: ChangeEvent<HTMLInputElement>) => {\r\n    const { name, value } = event.target;\r\n    setData({ ...data, [name]: value });\r\n  };\r\n\r\n  const handleSubmit = (event: ChangeEvent<HTMLFormElement>) => {\r\n    event.preventDefault();\r\n\r\n    try {\r\n      localStorage.clear();\r\n      const paramsString = location.search;\r\n      const params = new URLSearchParams(paramsString);\r\n      const email = params.get('e') || '';\r\n      const token = params.get('t') || '';\r\n\r\n      ativarUsuario(email, token).then(res => {\r\n        Alert(true, \"Sua conta foi ativada!\")\r\n        retornaUsuario(email).then(async res => {\r\n          await cadastrarOperacao({\r\n            nome: data.operacao,\r\n            celula: data.celula_1,\r\n            id_usuario: res.data._id,\r\n          });\r\n          await cadastrarOperacao({\r\n            nome: data.operacao,\r\n            celula: data.celula_2,\r\n            id_usuario: res.data._id,\r\n          });\r\n\r\n          history.push('/Login/');\r\n        })\r\n\r\n      }).catch(err => {\r\n        Alert(false, \"Ocorreu um erro ao ativar a conta!\")\r\n        history.push('/login')\r\n      })\r\n    } catch (error) {\r\n      Alert(false, \"Ocorreu um erro ao ativar a conta!\")\r\n      history.push('/login')\r\n    }\r\n  };\r\n\r\n  return (\r\n    <BoxCenter>\r\n      <div className=\"container\">\r\n        <header>\r\n          <img src={Logo} alt=\"Logo-VortexPro\" id=\"logo\" />\r\n          <h3>\r\n            CADASTRE UMA OPERAÇÃO\r\n          </h3>\r\n        </header>\r\n        <form onSubmit={handleSubmit}>\r\n          <Input\r\n            name=\"operacao\"\r\n            label=\"Operação\"\r\n            type=\"text\"\r\n            placeholder={'Digite o nome da operação'}\r\n            data={data.operacao}\r\n            setData={handleInputChange}\r\n            required={true}\r\n          />\r\n          <Input\r\n            name=\"celula_1\"\r\n            label=\"Sub-operacao 1\"\r\n            type=\"text\"\r\n            placeholder={'Digite o nome da célula 1'}\r\n            data={data.celula_1}\r\n            setData={handleInputChange}\r\n            required={true}\r\n          />\r\n          <Input\r\n            name=\"celula_2\"\r\n            label=\"Sub-operacao 2\"\r\n            type=\"text\"\r\n            placeholder={'Digite o nome da célula 2'}\r\n            data={data.celula_2}\r\n            setData={handleInputChange}\r\n            required={true}\r\n          />\r\n          <div className=\"field\">\r\n            <NavLink to=\"/\">Voltar para tela de Login</NavLink>\r\n          </div>\r\n          <div className=\"field\">\r\n            <button className=\"button\">Cadastrar Operação</button>\r\n          </div>\r\n        </form>\r\n      </div>\r\n    </BoxCenter>\r\n  );\r\n};\r\n\r\nexport default Cadastro;\r\n","D:\\dev\\02. VORTEXPRO\\vortexpro\\app\\src\\pages\\Perfil\\index.tsx",["282"],"import React, { useState, useEffect, ChangeEvent } from 'react';\r\nimport { NavLink } from 'react-router-dom';\r\nimport Header from '../../components/Header';\r\nimport Content from '../../components/Content';\r\nimport { PerfilStyled } from './StyledComponents'\r\n\r\nimport Input from '../../components/Form/Input';\r\nimport Select from '../../components/Form/Select';\r\nimport { FaEdit } from 'react-icons/fa'\r\nimport FotoPerfilDefault from '../../assets/images/default-user-image.png'\r\n\r\nimport {\r\n  retornaUsuarioLogado,\r\n  alterarUsuario,\r\n  uploadFotoUsuario\r\n} from '../../services/usuario';\r\nimport Alert from '../../helpers/Alert';\r\n\r\ninterface TypeData {\r\n  _id: string;\r\n  email: string;\r\n  empresa: string;\r\n  nome: string;\r\n  matricula: string,\r\n  plano: string;\r\n  senha?: string\r\n}\r\n\r\n\r\nexport default function Perfil() {\r\n\r\n  const [foto, setFoto] = useState<File>()\r\n  const [fotoURL, setFotoURL] = useState<string>('')\r\n\r\n  const [dataUser, setDataUser] = useState<TypeData>({\r\n    _id: '',\r\n    email: '',\r\n    empresa: '',\r\n    nome: '',\r\n    matricula: '',\r\n    plano: ''\r\n  })\r\n\r\n  useEffect(() => {\r\n    try {\r\n      retornaUsuarioLogado().then((res: any) => {\r\n        const { user } = res?.data\r\n        const dataNew = {\r\n          _id: user?._id || '',\r\n          email: user?.email || '',\r\n          empresa: user?.empresa || '',\r\n          nome: user?.nome || '',\r\n          matricula: user?.matricula || '',\r\n          plano: user?.plano || ''\r\n        }\r\n        setDataUser(dataNew)\r\n\r\n        if (user.foto)\r\n          setFotoURL(`${process.env.REACT_APP_API_URL}/usuario/images/${user.foto}`)\r\n      })\r\n    } catch (error) {\r\n      setDataUser({\r\n        _id: '',\r\n        email: '',\r\n        empresa: '',\r\n        nome: '',\r\n        matricula: '',\r\n        plano: ''\r\n      })\r\n    }\r\n  }, [])\r\n\r\n  useEffect(() => {\r\n    if (foto) {\r\n      const newUrl = URL.createObjectURL(foto)\r\n      setFotoURL(newUrl)\r\n    }\r\n  }, [foto])\r\n\r\n  const handleInputChange = (event: ChangeEvent<HTMLInputElement>) => {\r\n    const { name, value } = event.target;\r\n    setDataUser({ ...dataUser, [name]: value });\r\n  };\r\n\r\n  const handleSubmit = async (event: ChangeEvent<HTMLFormElement>) => {\r\n    event.preventDefault();\r\n    if (dataUser.senha?.length === 0) {\r\n      delete dataUser.senha;\r\n    }\r\n\r\n    await alterarUsuario(dataUser)\r\n\r\n    if (foto)\r\n      await uploadFotoUsuario(foto)\r\n\r\n    const dataUserNew = await retornaUsuarioLogado()\r\n\r\n    localStorage.setItem('usuario', JSON.stringify(dataUserNew.data.user));\r\n\r\n    Alert(true, \"Alterações salvas com sucesso!\")\r\n  };\r\n\r\n\r\n  return (\r\n    <>\r\n      <Header />\r\n      <Content titulo=\"Perfil\">\r\n        <PerfilStyled>\r\n          <form onSubmit={handleSubmit}>\r\n            <div id='home-foto'>\r\n              <img src={fotoURL || FotoPerfilDefault} />\r\n              <div id=\"image-upload\">\r\n                <label htmlFor=\"fileFoto\"><FaEdit /></label>\r\n                <input\r\n                  type=\"file\"\r\n                  id=\"fileFoto\"\r\n                  name=\"fileFoto\"\r\n                  accept='image/*'\r\n                  onChange={({ target }: any) => {\r\n                    setFoto(target.files[0]);\r\n                  }}\r\n                  placeholder={'Selecionar arquivo'}\r\n                  required={false}\r\n                />\r\n              </div>\r\n            </div>\r\n            <Input\r\n              name=\"nome\"\r\n              label=\"Nome\"\r\n              type=\"text\"\r\n              placeholder={'Digite seu nome'}\r\n              data={dataUser.nome}\r\n              setData={handleInputChange}\r\n              required={true}\r\n            />\r\n            <Input\r\n              name=\"matricula\"\r\n              label=\"RE/Matricula/ETC\"\r\n              type=\"text\"\r\n              placeholder={'Digite sua identificação na Empresa'}\r\n              data={dataUser.matricula}\r\n              setData={handleInputChange}\r\n            />\r\n            <Input\r\n              name=\"email\"\r\n              label=\"E-mail\"\r\n              type=\"email\"\r\n              placeholder={'Digite seu email'}\r\n              data={dataUser.email}\r\n              setData={handleInputChange}\r\n              required={true}\r\n              disabled={true}\r\n            />\r\n            <Input\r\n              name=\"empresa\"\r\n              label=\"Empresa\"\r\n              type=\"text\"\r\n              placeholder={'Digite o nome da empresa'}\r\n              data={dataUser.empresa}\r\n              setData={handleInputChange}\r\n              required={true}\r\n            />\r\n            <Input\r\n              name=\"senha\"\r\n              label=\"Senha\"\r\n              type=\"password\"\r\n              placeholder={'Digite a sua nova senha'}\r\n              data={dataUser.senha}\r\n              setData={handleInputChange}\r\n              required={false}\r\n            />\r\n            <Select\r\n              title=\"Plano\"\r\n              data={[\r\n                { _id: 'FREE', nome: 'FREE' },\r\n                { _id: 'BASIC', nome: 'BASIC' },\r\n                { _id: 'CLASS', nome: 'CLASS' },\r\n                { _id: 'PREMIUM', nome: 'PREMIUM' },\r\n\r\n              ]}\r\n              value={dataUser.plano}\r\n              setSelected={() => { }}\r\n              disabled={true}\r\n            />\r\n            <div className=\"field\">\r\n              <button className=\"button\">Salvar</button>\r\n            </div>\r\n          </form>\r\n          <div className=\"field\">\r\n            <NavLink to='/ExcluirConta' className=\"button warning\">Excluir conta</NavLink>\r\n          </div>\r\n        </PerfilStyled>\r\n      </Content>\r\n    </>\r\n  );\r\n}\r\n","D:\\dev\\02. VORTEXPRO\\vortexpro\\app\\src\\pages\\Home\\index.tsx",["283","284"],"D:\\dev\\02. VORTEXPRO\\vortexpro\\app\\src\\pages\\Cadastro\\index.tsx",[],"D:\\dev\\02. VORTEXPRO\\vortexpro\\app\\src\\services\\operacao.tsx",[],["285","286"],"D:\\dev\\02. VORTEXPRO\\vortexpro\\app\\src\\pages\\Simulador\\SimulatorSelected.tsx",["287"],"import React, { useState, useEffect } from 'react';\r\n\r\nimport { useDrop } from 'react-dnd';\r\nimport { ItemDragType } from './ItemDragType';\r\nimport ChartDoughnut from '../../components/Chart/ChartDoughnut';\r\nimport { NavLink } from 'react-router-dom';\r\nimport { FaQuestionCircle } from 'react-icons/fa';\r\n\r\n\r\ninterface TypeProps {\r\n  dataChartSelected: string;\r\n  dataChart: TypeDataChart[];\r\n  simulate: Function;\r\n}\r\n\r\ninterface TypeDataChart {\r\n  titulo: string;\r\n  planejado: number;\r\n  realizado: number;\r\n  replanejado: number;\r\n  desvio: number;\r\n}\r\n\r\nexport default function SimulatorSelected({\r\n  dataChartSelected,\r\n  dataChart,\r\n  simulate,\r\n}: TypeProps) {\r\n\r\n\r\n  const [qtyMonths, setQtyMonths] = useState<number>(1);\r\n  const [factor, setFactor] = useState<number>(1);\r\n\r\n  // function para reset do objeto\r\n  const emptyDataChart: TypeDataChart = {\r\n    titulo: 'Sem indicador Selecionado',\r\n    planejado: 0,\r\n    realizado: 0,\r\n    replanejado: 0,\r\n    desvio: 0,\r\n  };\r\n\r\n  // function para monitorar o efeito drop\r\n  const [{ canDrop, isOver }, drop] = useDrop(() => ({\r\n    accept: ItemDragType.CHART,\r\n    drop: () => ({\r\n      titulo: '',\r\n    }),\r\n    collect: (monitor) => ({\r\n      isOver: monitor.isOver(),\r\n      canDrop: monitor.canDrop(),\r\n    }),\r\n  }));\r\n\r\n  // verifica se tem algum item no dr\r\n  const isActive = canDrop && isOver;\r\n\r\n  const [dataChartFiltered, setDataChartFiltered] = useState<TypeDataChart>(\r\n    emptyDataChart\r\n  );\r\n\r\n  useEffect(() => {\r\n    const item: TypeDataChart[] = dataChart.filter(\r\n      (i: TypeDataChart) => i.titulo === dataChartSelected\r\n    );\r\n\r\n    item[0]\r\n      ? setDataChartFiltered(item[0])\r\n      : setDataChartFiltered(emptyDataChart);\r\n  }, [dataChart, dataChartSelected]);\r\n\r\n  return (\r\n    <section id=\"simulator-selected\" ref={drop}>\r\n      <h3>Arraste para cá um dos seus indicadores:</h3>\r\n      <div id=\"chart-selected\">\r\n        <h4 className=\"draf-info\">\r\n          {!isActive\r\n            ? 'Arraste para cá seu indicador a ser simulado'\r\n            : 'Solte aqui seu indicador'}\r\n          <NavLink to='/Orientacao/orientacaoSimulacao'>\r\n            <FaQuestionCircle className='icon-help' />\r\n          </NavLink>\r\n        </h4>\r\n        {!isActive && (\r\n          <ChartDoughnut\r\n            title={dataChartFiltered.titulo}\r\n            desvio={dataChartFiltered.desvio}\r\n            dataX={[\r\n              dataChartFiltered.planejado,\r\n              dataChartFiltered.realizado,\r\n              //dataChartFiltered.replanejado,\r\n            ]}\r\n            //label={['Planejado', 'Realizado', 'Replanejado']}\r\n            label={['Planejado', 'Realizado']}\r\n          />\r\n        )}\r\n        {dataChartFiltered.realizado > 0 && !isActive && (\r\n          <div id=\"simulator-control\">\r\n            <h4>Insira os parâmetros da simulação</h4>\r\n            <div id=\"simulator-control-row\">\r\n              <div className=\"list-buttons\">\r\n                <h5>Meses</h5>\r\n                <button className={qtyMonths === 1 ? 'button-active' : 'button'} onClick={() => { setQtyMonths(1) }}>1</button>\r\n                <button className={qtyMonths === 2 ? 'button-active' : 'button'} onClick={() => { setQtyMonths(2) }}>2</button>\r\n                <button className={qtyMonths === 3 ? 'button-active' : 'button'} onClick={() => { setQtyMonths(3) }}>3</button>\r\n              </div>\r\n              <div className=\"list-buttons\">\r\n                <h5>Fator</h5>\r\n                <button className={factor === -3 ? 'button-active' : 'button'} onClick={() => setFactor(-3)}>-3°</button>\r\n                <button className={factor === -2 ? 'button-active' : 'button'} onClick={() => setFactor(-2)}>-2°</button>\r\n                <button className={factor === -1 ? 'button-active' : 'button'} onClick={() => setFactor(-1)}>-1°</button>\r\n                <button className={factor === 1 ? 'button-active' : 'button'} onClick={() => setFactor(1)}> 1°</button>\r\n                <button className={factor === 2 ? 'button-active' : 'button'} onClick={() => setFactor(2)}> 2°</button>\r\n                <button className={factor === 3 ? 'button-active' : 'button'} onClick={() => setFactor(3)}> 3°</button>\r\n              </div>\r\n            </div>\r\n            <div className=\"field\">\r\n              <button className=\"button\" onClick={() => simulate(factor, qtyMonths)}>Simular</button>\r\n            </div>\r\n          </div>\r\n        )}\r\n      </div>\r\n    </section>\r\n  );\r\n}\r\n","D:\\dev\\02. VORTEXPRO\\vortexpro\\app\\src\\pages\\ExcluirConta\\StyledComponents.tsx",[],"D:\\dev\\02. VORTEXPRO\\vortexpro\\app\\src\\pages\\Administracao\\StyledComponents.tsx",[],"D:\\dev\\02. VORTEXPRO\\vortexpro\\app\\src\\pages\\Orientacao\\StyledComponents.tsx",[],"D:\\dev\\02. VORTEXPRO\\vortexpro\\app\\src\\helpers\\ExportPDF.tsx",[],["288","289"],"D:\\dev\\02. VORTEXPRO\\vortexpro\\app\\src\\pages\\ImportarDados\\index.tsx",[],"D:\\dev\\02. VORTEXPRO\\vortexpro\\app\\src\\pages\\Permissionamento\\index.tsx",["290","291","292","293","294"],"import React, { useState, useEffect, ChangeEvent } from 'react';\r\nimport { useHistory } from 'react-router-dom';\r\nimport Header from '../../components/Header';\r\nimport Content from '../../components/Content';\r\nimport { AdminStyled } from './StyledComponents'\r\n\r\nimport { listaUsuarios, alterarUsuario } from '../../services/usuario'\r\nimport Select from '../../components/Form/Select';\r\nimport Alert from '../../helpers/Alert';\r\n\r\n\r\nconst opcoesPermissao = [\r\n  { _id: '1', nome: '1 mês' },\r\n  { _id: '2', nome: '2 meses' },\r\n  { _id: '3', nome: '3 meses' },\r\n  { _id: '4', nome: '4 meses' },\r\n  { _id: '5', nome: '5 meses' },\r\n  { _id: '6', nome: '6 meses' },\r\n  { _id: '7', nome: '7 meses' },\r\n  { _id: '8', nome: '8 meses' },\r\n  { _id: '9', nome: '9 meses' },\r\n  { _id: '10', nome: '10 meses' },\r\n  { _id: '11', nome: '11 meses' },\r\n  { _id: '12', nome: '12 meses' },\r\n  { _id: '24', nome: '24 meses' },\r\n  { _id: '36', nome: '36 meses' },\r\n  { _id: '99999', nome: '99999 meses' }\r\n]\r\nconst opcoesPermissaoProjecao = [\r\n  { _id: '1', nome: '1 mês' },\r\n  { _id: '2', nome: '2 meses' },\r\n  { _id: '3', nome: '3 meses' },\r\n  { _id: '4', nome: '4 meses' },\r\n  { _id: '5', nome: '5 meses' },\r\n  { _id: '6', nome: '6 meses' },\r\n]\r\nexport default function Permissionamento() {\r\n\r\n  const [usuarios, setUsuarios] = useState<any[]>([]);\r\n  let history = useHistory();\r\n\r\n  useEffect(() => {\r\n    listaUsuarios().then(res => {\r\n      setUsuarios(res.data)\r\n    }).catch(err => {\r\n      history.push('/Home');\r\n    })\r\n  }, [])\r\n\r\n  const updatePermissao = (usuario: string, name: string, permissao: any) => {\r\n    const listaUsuarios = [...usuarios];\r\n\r\n    const index = listaUsuarios.findIndex(a => a._id === usuario)\r\n    listaUsuarios[index][name = name] = permissao\r\n    setUsuarios(listaUsuarios)\r\n    alterarUsuario(listaUsuarios[index]).catch(err => { Alert(false, 'Ocorreu um erro ao salvar') })\r\n  }\r\n\r\n  return (\r\n    <AdminStyled>\r\n      <table>\r\n        <thead>\r\n          <tr>\r\n            <th>Empresa</th>\r\n            <th>Cliente</th>\r\n            <th>E-mail</th>\r\n            <th>Plano</th>\r\n            <th>Perfil</th>\r\n            <th>Status</th>\r\n            <th>Inclusão de Histórico</th>\r\n            <th>Filtros</th>\r\n            <th>Projeções</th>\r\n          </tr>\r\n        </thead>\r\n        <tbody>\r\n          {usuarios.map((res, index) =>\r\n            <tr key={index}>\r\n              <td>{res.empresa}</td>\r\n              <td>{res.nome}</td>\r\n              <td>{res.email}</td>\r\n              <td>{res.plano}</td>\r\n              <td>\r\n                <Select\r\n                  data={[\r\n                    { _id: 'user', nome: 'Usuário' },\r\n                    { _id: 'admin', nome: 'Admin' }\r\n                  ]}\r\n                  value={res.role}\r\n                  setSelected={(permissao: string) => { updatePermissao(res._id, 'role', permissao) }}\r\n                  required={true}\r\n                />\r\n              </td>\r\n              <td>\r\n                <Select\r\n                  data={[\r\n                    { _id: 'false', nome: 'Inativo' },\r\n                    { _id: 'true', nome: 'Ativo' }\r\n                  ]}\r\n                  value={res.status}\r\n                  setSelected={(permissao: number) => { updatePermissao(res._id, 'status', permissao) }}\r\n                  required={true}\r\n                />\r\n              </td>\r\n              <td>\r\n                <Select\r\n                  data={opcoesPermissao}\r\n                  value={res.permissaoHistorico}\r\n                  setSelected={(permissao: number) => { updatePermissao(res._id, 'permissaoHistorico', permissao) }}\r\n                  required={true}\r\n                />\r\n              </td>\r\n              <td>\r\n                <Select\r\n                  data={opcoesPermissao}\r\n                  value={res.permissaoFiltro}\r\n                  setSelected={(permissao: number) => { updatePermissao(res._id, 'permissaoFiltro', permissao) }}\r\n                  required={true}\r\n                />\r\n              </td>\r\n              <td>\r\n                <Select\r\n                  data={opcoesPermissaoProjecao}\r\n                  value={res.permissaoProjecao}\r\n                  setSelected={(permissao: number) => { updatePermissao(res._id, 'permissaoProjecao', permissao) }}\r\n                  required={true}\r\n                />\r\n              </td>\r\n            </tr>\r\n          )}\r\n        </tbody>\r\n      </table>\r\n    </AdminStyled>\r\n  );\r\n}\r\n",["295","296"],"D:\\dev\\02. VORTEXPRO\\vortexpro\\app\\src\\components\\Chart\\ChartBar.tsx",[],"D:\\dev\\02. VORTEXPRO\\vortexpro\\app\\src\\components\\Chart\\styles.tsx",[],["297","298"],"D:\\dev\\02. VORTEXPRO\\vortexpro\\app\\src\\components\\Header\\styles.tsx",[],"D:\\dev\\02. VORTEXPRO\\vortexpro\\app\\src\\components\\Spinner\\styles.tsx",[],"D:\\dev\\02. VORTEXPRO\\vortexpro\\app\\src\\App.tsx",[],["299","300"],"D:\\dev\\02. VORTEXPRO\\vortexpro\\app\\src\\pages\\Login\\index.tsx",[],"D:\\dev\\02. VORTEXPRO\\vortexpro\\app\\src\\pages\\Dashboard\\index.tsx",["301","302","303","304"],"D:\\dev\\02. VORTEXPRO\\vortexpro\\app\\src\\pages\\ExcluirConta\\index.tsx",[],"D:\\dev\\02. VORTEXPRO\\vortexpro\\app\\src\\config\\api.tsx",[],"D:\\dev\\02. VORTEXPRO\\vortexpro\\app\\src\\assets\\styles\\boxCenter.tsx",[],"D:\\dev\\02. VORTEXPRO\\vortexpro\\app\\src\\pages\\Perfil\\StyledComponents.tsx",[],"D:\\dev\\02. VORTEXPRO\\vortexpro\\app\\src\\services\\simulador.tsx",[],"D:\\dev\\02. VORTEXPRO\\vortexpro\\app\\src\\pages\\Simulador\\GridResults.tsx",[],"D:\\dev\\02. VORTEXPRO\\vortexpro\\app\\src\\components\\Chart\\ChartMix.tsx",[],"D:\\dev\\02. VORTEXPRO\\vortexpro\\app\\src\\components\\Header\\index.tsx",[],"D:\\dev\\02. VORTEXPRO\\vortexpro\\app\\src\\components\\Form\\Select\\index.tsx",[],"D:\\dev\\02. VORTEXPRO\\vortexpro\\app\\src\\index.tsx",[],"D:\\dev\\02. VORTEXPRO\\vortexpro\\app\\src\\assets\\styles\\global.tsx",[],"D:\\dev\\02. VORTEXPRO\\vortexpro\\app\\src\\pages\\ResetarSenha\\index.tsx",["305"],"import React, { useState, useEffect, ChangeEvent } from 'react';\r\nimport { NavLink, useHistory } from 'react-router-dom';\r\n\r\nimport { BoxCenter } from '../../assets/styles/boxCenter';\r\nimport Input from '../../components/Form/Input';\r\nimport Logo from '../../assets/images/logo.png';\r\n\r\nimport { resetarSenha } from '../../services/usuario';\r\nimport Alert from '../../helpers/Alert';\r\n\r\ninterface TypeData {\r\n  senha: string;\r\n  confirmaSenha: string;\r\n}\r\n\r\nconst ResetarSenha = ({ location }: any) => {\r\n  let history = useHistory();\r\n\r\n  const [data, setData] = useState<TypeData>({\r\n    senha: '',\r\n    confirmaSenha: '',\r\n  });\r\n  const [token, setToken] = useState('')\r\n  const [email, setEmail] = useState('')\r\n\r\n\r\n  useEffect(() => {\r\n    try {\r\n      const paramsString = location.search;\r\n      const params = new URLSearchParams(paramsString);\r\n      const email = params.get('e') || '';\r\n      const token = params.get('t') || '';\r\n      setToken(token)\r\n      setEmail(email)\r\n\r\n    } catch (err) {\r\n      console.log(err)\r\n\r\n    }\r\n\r\n  }, [])\r\n\r\n  const handleInputChange = (event: ChangeEvent<HTMLInputElement>) => {\r\n    const { name, value } = event.target;\r\n    setData({ ...data, [name]: value });\r\n  };\r\n\r\n  const handleSubmit = (event: ChangeEvent<HTMLFormElement>) => {\r\n    event.preventDefault();\r\n    const { senha } = data;\r\n\r\n    const is_valid = validation();\r\n    if (is_valid)\r\n      resetarSenha(email, token, senha).then(res => {\r\n        Alert(true, 'Senha alterada com sucesso!');\r\n        history.push('/login')\r\n      }).catch(err => {\r\n        Alert(false, \"Ocorreu um erro ao alterar senha!\")\r\n      })\r\n  };\r\n\r\n  const validation = () => {\r\n    const { senha, confirmaSenha } = data;\r\n\r\n    // Validações\r\n    if (senha !== confirmaSenha) {\r\n      Alert(false, 'Confirmação de senha incorreta');\r\n    } else {\r\n      return true;\r\n    }\r\n  };\r\n\r\n  return (\r\n    <BoxCenter>\r\n      <div className=\"container\">\r\n        <header>\r\n          <img src={Logo} alt=\"Logo-VortexPro\" id=\"logo\" />\r\n          <h3>ALTERAR SENHA</h3>\r\n        </header>\r\n        <form onSubmit={handleSubmit}>\r\n          <Input\r\n            name=\"senha\"\r\n            label=\"Nova senha\"\r\n            type=\"password\"\r\n            placeholder={'Digite sua nova senha'}\r\n            data={data.senha}\r\n            setData={handleInputChange}\r\n            required={true}\r\n          />\r\n          <Input\r\n            name=\"confirmaSenha\"\r\n            label=\"Confirme a nova senha\"\r\n            type=\"password\"\r\n            placeholder={'Confirme sua nova senha'}\r\n            data={data.confirmaSenha}\r\n            setData={handleInputChange}\r\n            required={true}\r\n          />\r\n          <div className=\"field\">\r\n            <NavLink to=\"/\">Voltar para tela de Login</NavLink>\r\n          </div>\r\n          <div className=\"field\">\r\n            <button className=\"button\">Alterar Senha</button>\r\n          </div>\r\n        </form>\r\n      </div>\r\n    </BoxCenter>\r\n  );\r\n};\r\n\r\nexport default ResetarSenha;\r\n","D:\\dev\\02. VORTEXPRO\\vortexpro\\app\\src\\pages\\Administracao\\index.tsx",[],"D:\\dev\\02. VORTEXPRO\\vortexpro\\app\\src\\services\\resultado.tsx",[],"D:\\dev\\02. VORTEXPRO\\vortexpro\\app\\src\\components\\Content\\index.tsx",[],"D:\\dev\\02. VORTEXPRO\\vortexpro\\app\\src\\components\\Form\\Input\\index.tsx",[],"D:\\dev\\02. VORTEXPRO\\vortexpro\\app\\src\\pages\\Orientacao\\index.tsx",["306","307","308","309","310","311","312","313","314"],"import React, { useState, useEffect } from 'react';\r\nimport { useHistory } from 'react-router-dom';\r\nimport Header from '../../components/Header';\r\nimport Content from '../../components/Content';\r\nimport { ContainerStyled } from './StyledComponents'\r\n\r\nimport { FaArrowLeft } from 'react-icons/fa'\r\nimport { verificaAutenticacao } from '../../services/usuario'\r\n\r\nimport ImgCadastro1 from '../../assets/images/orientacao-cadastro-1.jpg'\r\nimport ImgCadastro2 from '../../assets/images/orientacao-cadastro-2.jpg'\r\nimport ImgCadastro3 from '../../assets/images/orientacao-cadastro-3.jpg'\r\n\r\n\r\nimport ImgImportar1 from '../../assets/images/orientacao-importar-1.jpg'\r\n\r\nexport default function Orientacao(props: any) {\r\n  const history = useHistory();\r\n\r\n  const [usuarioLogado, setUsuarioLogado] = useState(false)\r\n  const [tipoOrientacao, setTipoOrientacao] = useState('')\r\n\r\n  useEffect(() => {\r\n    //captura o parametro \r\n    const { id } = props.match.params;\r\n    setTipoOrientacao(id)\r\n\r\n    // verifica se o usuario esta logado para exibir o header\r\n    setUsuarioLogado(verificaAutenticacao())\r\n  }, [])\r\n\r\n  // verifica qual orientaçao sera exibida\r\n  const componentOrientacao = () => {\r\n    switch (tipoOrientacao) {\r\n      case 'orientacaoCadastroUsuario': return <OrientacaoCadastro />\r\n        break;\r\n      case 'PoliticaPrivacidade': return <PoliticaPrivacidade />\r\n        break;\r\n      case 'importar': return <OrientacaoImportar />\r\n        break;\r\n      case 'orientacaoSimulacao': return <OrientacaoSimulacao />\r\n        break;\r\n      default: return <OrientacaoDefault />\r\n    }\r\n  }\r\n\r\n  return (\r\n    <>\r\n      {usuarioLogado && (<Header />)}\r\n      <button style={{ margin: ' 20px 0 0 30px' }} className='button' onClick={() => history.go(-1)} ><FaArrowLeft /> Voltar</button>\r\n\r\n      {componentOrientacao()}\r\n\r\n    </>\r\n  );\r\n}\r\n\r\nfunction OrientacaoCadastro() {\r\n  return (\r\n    <Content titulo=\"Orientação de Cadastro\">\r\n      <ContainerStyled>\r\n        <img src={ImgCadastro1} />\r\n        <section>\r\n          <h3>Como me cadastrar no Vortexpro?</h3>\r\n          <p>Para se cadastrar no Vortexpro e desenvolver o processo de tomada de decisão, você seguirá os seguintes passos:</p>\r\n          <ol>\r\n            <li>Clique em <strong>Sou novo aqui</strong></li>\r\n            <li>Você será direcionado para a <strong>tela de cadastro</strong></li>\r\n            <li>Preencha o <strong>formulário de cadastro</strong></li>\r\n          </ol>\r\n          <p>\r\n            Finalizada essas etapas você será direcionado para a tela de <strong>formulário de cadastro</strong>.\r\n          </p>\r\n        </section>\r\n      </ContainerStyled >\r\n\r\n      <ContainerStyled>\r\n        <img src={ImgCadastro2} />\r\n        <section>\r\n          <h3>Como preencher o formulário de cadastro do Vortexpro?</h3>\r\n          <p>Para preencher o formulário de cadastro do Vortexpro, você seguirá os seguintes passos:</p>\r\n          <ol>\r\n            <li>Digite seu nome no campo <strong>Nome</strong></li>\r\n            <li>Digite seu e-mail no campo <strong>E-mail</strong></li>\r\n            <li>Digite o nome da sua empresa no campo <strong>Empresa</strong></li>\r\n            <li>Digite sua senha no campo <strong>Senha</strong></li>\r\n            <li>Confirme a sua senha no campo <strong>Conforme a senha</strong></li>\r\n            <li>Para finalizar clique em <strong>Cadastrar</strong></li>\r\n          </ol>\r\n          <p>\r\n            Finalizada essas etapas você receberá um E-mail para confirmar seu cadastro.\r\n          </p>\r\n        </section>\r\n      </ContainerStyled >\r\n\r\n      <ContainerStyled>\r\n        <img src={ImgCadastro3} />\r\n        <section>\r\n          <h3>Como cadastrar uma operação no Vortexpro?</h3>\r\n          <p>Para preencher o formulário de cadastro de operação no Vortexpro, você seguirá os seguintes passos:</p>\r\n          <ol>\r\n            <li>Clique em <strong>Sou novo aqui</strong></li>\r\n            <li>Digite o nome da operação no campo <strong>Operação</strong></li>\r\n            <li>Digite o nome da célula 1 no campo <strong>Sub-operação 1</strong></li>\r\n            <li>Digite o nome da célula 2 no campo <strong>Sub-operação 2</strong></li>\r\n            <li>Para finalizar clique em Cadastrar <strong>Operação</strong></li>\r\n          </ol>\r\n          <p>\r\n            Finalizada essas etapas você será direcionado para sua tela inicial e está pronto para desenvolver o processo de tomada de decisão!\r\n          </p>\r\n        </section>\r\n      </ContainerStyled >\r\n    </Content >\r\n  )\r\n}\r\nfunction OrientacaoImportar() {\r\n  return (\r\n    <Content titulo=\"Orientação\">\r\n      <ContainerStyled>\r\n        <img src={ImgImportar1} />\r\n        <section>\r\n          <h3>Como importar meus dados no Vortexpro?</h3>\r\n          <p>Para importar os seus dados no Vortexpro o primeiro passo é realizar o download do arquivo modelo. Você seguirá os seguintes passos:</p>\r\n          <ol>\r\n            <li>Em Administração acesse <strong>Importar dados</strong></li>\r\n            <li>Clique em <strong>arquivo_modelo.xlsx</strong> conforme a imagem</li>\r\n          </ol>\r\n          <p>\r\n            Finalizada essas etapas será realizada o download do arquivo modelo.\r\n        </p>\r\n        </section>\r\n      </ContainerStyled>\r\n      <ContainerStyled>\r\n        <section>\r\n          <h3>Como preencher as informações no arquivo modelo?</h3>\r\n          <p>Após obter o arquivo modelo será necessário realizar o preenchimento com seus indicadores. Para isso é existem alguns pontos de atenção:</p>\r\n          <ol>\r\n            <li>Copie as informações do seu sistema de origem e cole no formato da planilha;</li>\r\n            <li>Remova as fórmulas do seu arquivo antes de salvar;</li>\r\n            <li>Certifique-se de que não tem caracteres em texto nos campos númericos;</li>\r\n            <li>Confira o formato dos seus dados.</li>\r\n          </ol>\r\n        </section>\r\n      </ContainerStyled>\r\n      <ContainerStyled>\r\n        <section>\r\n          <h3>Qual formato dos dados para o arquivo?</h3>\r\n          <p>Para preencher o arquivo as informações precisam seguir um formato, sendo eles:</p>\r\n          <ol>\r\n            <li><strong>DATA:</strong> Campo no formato data;</li>\r\n            <li><strong>KPI_VOLUME:</strong> Campo no formato de número inteiro;</li>\r\n            <li><strong>KPI_VOLUME_P:</strong> Campo no formato de número inteiro;</li>\r\n            <li><strong>KPI_TMO:</strong> Campo no formato de número inteiro;</li>\r\n            <li><strong>KPI_TMO_P:</strong> Campo no formato de número inteiro;</li>\r\n            <li><strong>KPI_NS:</strong> Campo no formato de número decimal com duas casas depois da vírgula;</li>\r\n            <li><strong>KPI_NS_P:</strong> Campo no formato de número decimal com duas casas depois da vírgula;</li>\r\n            <li><strong>KPI_PA_HC:</strong> Campo no formato de número inteiro;</li>\r\n            <li><strong>KPI_PA_HC_P:</strong> Campo no formato de número inteiro;</li>\r\n            <li><strong>KPI_NPS:</strong> Campo no formato de número inteiro;</li>\r\n            <li><strong>KPI_NPS_P:</strong> Campo no formato de número inteiro;</li>\r\n            <li><strong>KPI_CSAT:</strong> Campo no formato de número inteiro;</li>\r\n            <li><strong>KPI_CSAT_P:</strong> Campo no formato de número inteiro;</li>\r\n\r\n          </ol>\r\n        </section>\r\n      </ContainerStyled>\r\n    </Content>\r\n  )\r\n}\r\nfunction PoliticaPrivacidade() {\r\n  return (\r\n    <Content titulo=\"POLÍTICA DE PRIVACIDADE\">\r\n      <ContainerStyled>\r\n        <section>\r\n          <p>Este site é mantido e operado por Vortex Pro.</p>\r\n          <p>Nós coletamos e utilizamos alguns dados pessoais que pertencem àqueles que\r\n          utilizam nosso site. Ao fazê-lo, agimos na qualidade de controlador desses dados e\r\n          estamos sujeitos às disposições da Lei Federal n. 13.709/2018 (Lei Geral de\r\n          Proteção de Dados Pessoais - LGPD).</p>\r\n          <p>\r\n            Nós cuidamos da proteção de seus dados pessoais e, por isso, disponibilizamos\r\n            esta política de privacidade, que contém informações importantes sobre:\r\n          </p>\r\n          <p>\r\n            - Quem deve utilizar nosso site<br />\r\n            - Quais dados coletamos e o que fazemos com eles;<br />\r\n            - Seus direitos em relação aos seus dados pessoais; e<br />\r\n            - Como entrar em contato conosco.\r\n          </p>\r\n        </section>\r\n      </ContainerStyled>\r\n\r\n      <ContainerStyled>\r\n        <section>\r\n          <h1>1. Dados que coletamos e motivos da coleta</h1>\r\n          <p>Nosso site coleta e utiliza alguns dados pessoais de nossos usuários, de acordo com o disposto nesta seção. </p>\r\n\r\n          <br /><i>1.\tDados pessoais fornecidos expressamente pelo usuário</i>\r\n          <p>Nós coletamos os seguintes dados pessoais que nossos usuários nos fornecem expressamente ao utilizar nosso site: </p>\r\n          <p>\r\n            - Nome Completo<br />\r\n            - RE/Matricula<br />\r\n            - E-mail<br />\r\n            - Empresa\r\n          </p>\r\n          <p>A coleta destes dados ocorre nos seguintes momentos:</p>\r\n          <p>- Quando o Usuário faz o cadastro no site para utilização da Ferramenta.</p>\r\n          <p>Os dados fornecidos por nossos usuários são coletados com as seguintes finalidades:</p>\r\n          <p>- Para que o usuário possa adquirir o nosso produto/serviço.</p>\r\n\r\n          <br /><i>2.\tDados sensíveis</i>\r\n          <p><strong>Não</strong> serão coletados dados sensíveis de nossos usuários, assim entendidos aqueles definidos nos arts. 11 e seguintes da Lei de Proteção de Dados Pessoais. Assim, não haverá coleta de dados sobre origem racial ou étnica, convicção religiosa, opinião política, filiação a sindicato ou a organização de caráter religioso, filosófico ou político, dado referente à saúde ou à vida sexual, dado genético ou biométrico, quando vinculado a uma pessoa natural.</p>\r\n\r\n\r\n          <br /><i>3.\tCookies</i>\r\n          <p>Cookies são pequenos arquivos de texto baixados automaticamente em seu dispositivo quando você acessa e navega por um site. Eles servem, basicamente, para seja possível identificar dispositivos, atividades e preferências de usuários.</p>\r\n          <p>Os cookies não permitem que qualquer arquivo ou informação sejam extraídos do disco rígido do usuário, não sendo possível, ainda, que, por meio deles, se tenha acesso a informações pessoais que não tenham partido do usuário ou da forma como utiliza os recursos do site.</p>\r\n\r\n          <br /><i> a.\tCookies do site</i>\r\n          <p>Os cookies do site são aqueles enviados ao computador ou dispositivo do usuário e administrador exclusivamente pelo site.</p>\r\n          <p>As informações coletadas por meio destes cookies são utilizadas para melhorar e personalizar a experiência do usuário, sendo que alguns cookies podem, por exemplo, ser utilizados para lembrar as preferências e escolhas do usuário, bem como para o oferecimento de conteúdo personalizado.</p>\r\n\r\n\r\n          <br /><i> b.\tGestão de cookies</i>\r\n          <p>O usuário poderá se opor ao registro de cookies pelo site, bastando que desative esta opção no seu próprio navegador. Mais informações sobre como fazer isso em alguns dos principais navegadores utilizados hoje podem ser acessadas a partir dos seguintes links:</p>\r\n\r\n          <p>\r\n            Internet Explorer:<br />\r\n            https://support.microsoft.com/pt-br/help/17442/windows-internet-explorer-delete- manage-cookies<br /><br />\r\n            Google Chrome:<br />\r\n            https://support.google.com/chrome/answer/95647?hl=pt-BR&hlrm=pt<br /><br />\r\n            Mozila Firefox:<br />\r\n            https://support.mozilla.org/pt-BR/kb/ative-e-desative-os-cookies-que-os-sites-usam<br /><br />\r\n            Opera:<br />\r\n            https://www.opera.com/help/tutorials/security/privacy/<br /><br />\r\n          </p>\r\n          <p>A desativação dos cookies, no entanto, pode afetar a disponibilidade de algumas ferramentas e funcionalidades do site, comprometendo seu correto e esperado funcionamento. Outra consequência possível é remoção das preferências do usuário que eventualmente tiverem sido salvas, prejudicando sua experiência.</p>\r\n\r\n\r\n          <br /><i>4.\tColeta de dados não previstos expressamente</i>\r\n          <p>Eventualmente, outros tipos de dados não previstos expressamente nesta Política de Privacidade poderão ser coletados, desde que sejam fornecidos com o consentimento do usuário, ou, ainda, que a coleta seja permitida com fundamento em outra base legal prevista em lei.</p>\r\n          <p>Em qualquer caso, a coleta de dados e as atividades de tratamento dela decorrentes serão informadas aos usuários do site.</p>\r\n        </section>\r\n      </ContainerStyled>\r\n\r\n      <ContainerStyled>\r\n        <section>\r\n          <h1>2.\tCompartilhamento de dados pessoais com terceiros</h1>\r\n          <p>Nós não compartilhamos seus dados pessoais com terceiros. Apesar disso, é possível que o façamos para cumprir alguma determinação legal ou regulatória, ou, ainda, para cumprir alguma ordem expedida por autoridade pública.</p>\r\n        </section>\r\n      </ContainerStyled>\r\n\r\n      <ContainerStyled>\r\n        <section>\r\n          <h1>3.\tPor quanto tempo seus dados pessoais serão armazenados</h1>\r\n          <p>Os dados pessoais coletados pelo site são armazenados e utilizados por período de tempo que corresponda ao necessário para atingir as finalidades elencadas neste documento e que considere os direitos de seus titulares, os direitos do controlador do site e as disposições legais ou regulatórias aplicáveis.</p>\r\n          <p>Uma vez expirados os períodos de armazenamento dos dados pessoais, eles são removidos de nossas bases de dados ou anonimizados, salvo nos casos em que houver a possibilidade ou a necessidade de armazenamento em virtude de disposição legal ou regulatória.</p>\r\n        </section>\r\n      </ContainerStyled>\r\n\r\n      <ContainerStyled>\r\n        <section>\r\n          <h1>4.\tBases legais para o tratamento de dados pessoais</h1>\r\n          <p>Cada operação de tratamento de dados pessoais precisa ter um fundamento jurídico, ou seja, uma base legal, que nada mais é que uma justificativa que a autorize, prevista na Lei Geral de Proteção de Dados Pessoais.</p>\r\n          <p>Todas as Nossas atividades de tratamento de dados pessoais possuem uma base legal que as fundamenta, dentre as permitidas pela legislação. Mais informações sobre as bases legais que utilizamos para operações de tratamento de dados pessoais específicas podem ser obtidas a partir de nossos canais de contato, informados ao final desta Política.</p>\r\n        </section>\r\n      </ContainerStyled>\r\n\r\n      <ContainerStyled>\r\n        <section>\r\n          <h1>5.\tDireitos do usuário</h1>\r\n          <p>O usuário do site possui os seguintes direitos, conferidos pela Lei de Proteção de Dados Pessoais:</p>\r\n          <p>\r\n            -\tconfirmação da existência de tratamento;<br />\r\n            -\tacesso aos dados;<br />\r\n            -\tcorreção de dados incompletos, inexatos ou desatualizados;<br />\r\n            -\tanonimização, bloqueio ou eliminação de dados desnecessários, excessivos ou tratados em desconformidade com o disposto na lei;<br />\r\n            -\tportabilidade dos dados a outro fornecedor de serviço ou produto, mediante requisição expressa, de acordo com a regulamentação da autoridade nacional, observados os segredos comercial e industrial;<br />\r\n            -\teliminação dos dados pessoais tratados com o consentimento do titular, exceto nos casos previstos em lei;<br />\r\n            -\tinformação das entidades públicas e privadas com as quais o controlador realizou uso compartilhado de dados;<br />\r\n            -\tinformação sobre a possibilidade de não fornecer consentimento e sobre as consequências da negativa;<br />\r\n            -\trevogação do consentimento.\r\n          </p>\r\n          <p>É importante destacar que, nos termos da LGPD, não existe um direito de eliminação de dados tratados com fundamento em bases legais distintas do consentimento, a menos que os dados seja desnecessários, excessivos ou tratados em desconformidade com o previsto na lei.</p>\r\n\r\n          <br /><i>1.Como o titular pode exercer seus direitos</i>\r\n          <p>Para garantir que o usuário que pretende exercer seus direitos é, de fato, o titular dos dados pessoais objeto da requisição, poderemos solicitar documentos ou outras informações que possam auxiliar em sua correta identificação, a fim de resguardar nossos direitos e os direitos de terceiros. Isto somente será feito, porém, se for absolutamente necessário, e o requerente receberá todas as informações relacionadas.</p>\r\n        </section>\r\n      </ContainerStyled>\r\n\r\n      <ContainerStyled>\r\n        <section>\r\n          <h1>6.\tMedidas de segurança no tratamento de dados pessoais</h1>\r\n          <p>Empregamos medidas técnicas e organizativas aptas a proteger os dados pessoais de acessos não autorizados e de situações de destruição, perda, extravio ou alteração desses dados.</p>\r\n          <p>As medidas que utilizamos levam em consideração a natureza dos dados, o contexto e a finalidade do tratamento, os riscos que uma eventual violação geraria para os direitos e liberdades do usuário, e os padrões atualmente empregados no mercado por empresas semelhantes à nossa.</p>\r\n          <p>Entre as medidas de segurança adotadas por nós, destacamos as seguintes:</p>\r\n          <p>\r\n            -\tArmazenamento de senhas utilizando hashes criptográficos;<br />\r\n            -\tRestrições de acessos a banco de dados;<br />\r\n            -\tMonitoramento de acesso físico a servidores.\r\n          </p>\r\n          <p>Ainda que adote tudo o que está ao seu alcance para evitar incidentes de segurança, é possível que ocorra algum problema motivado exclusivamente por um terceiro - como em caso de ataques de hackers ou crackers ou, ainda, em caso de culpa exclusiva do usuário, que ocorre, por exemplo, quando ele mesmo transfere seus dados a terceiro. Assim, embora sejamos, em geral, responsáveis pelos dados pessoais que tratamos, nos eximimos de responsabilidade caso ocorra uma situação excepcional como essas, sobre as quais não temos nenhum tipo de controle.</p>\r\n          <p>De qualquer forma, caso ocorra qualquer tipo de incidente de segurança que possa gerar risco ou dano relevante para qualquer de nossos usuários, comunicaremos os afetados e a Autoridade Nacional de Proteção de Dados acerca do ocorrido, em conformidade com o disposto na Lei Geral de Proteção de Dados.</p>\r\n\r\n        </section>\r\n      </ContainerStyled>\r\n\r\n      <ContainerStyled>\r\n        <section>\r\n          <h1>7.\tReclamação a uma autoridade de controle</h1>\r\n          <p>Sem prejuízo de qualquer outra via de recurso administrativo ou judicial, os titulares de dados pessoais que se sentirem, de qualquer forma, lesados, podem apresentar reclamação à Autoridade Nacional de Proteção de Dados.</p>\r\n        </section>\r\n      </ContainerStyled>\r\n\r\n      <ContainerStyled>\r\n        <section>\r\n          <h1>8.\tAlterações nesta política</h1>\r\n          <p>A presente versão desta Política de Privacidade foi atualizada pela última vez em: 01/07/2021.</p>\r\n          <p>Reservamo-nos o direito de modificar, a qualquer momento, as presentes normas, especialmente para adaptá-las às eventuais alterações feitas em nosso site, seja pela disponibilização de novas funcionalidades, seja pela supressão ou modificação daquelas já existentes.</p>\r\n          <p>Sempre que houver uma modificação, nossos usuários serão notificados acerca da mudança.</p>\r\n        </section>\r\n      </ContainerStyled>\r\n\r\n      <ContainerStyled>\r\n        <section>\r\n          <h1>9.\tComo entrar em contato conosco</h1>\r\n          <p>Para esclarecer quaisquer dúvidas sobre esta Política de Privacidade ou sobre os dados pessoais que tratamos, entre em contato com nosso Encarregado de Proteção de Dados Pessoais, por algum dos canais mencionados abaixo:</p>\r\n          <br />\r\n          <p>E-mail: vortexpro@vortex.io </p>\r\n          <p>Endereço postal: Rua João Coelho de Morais, 55</p>\r\n          <p>Vila Bela / CEP.: 03203-060</p>\r\n        </section>\r\n      </ContainerStyled>\r\n\r\n    </Content>\r\n  )\r\n}\r\nfunction OrientacaoSimulacao() {\r\n  return (\r\n    <Content titulo=\"Orientação de uso Simulador\">\r\n      <ContainerStyled>\r\n        <section>\r\n          <h1>Independente do indicador que você arrastar para ser simulado os cenarios são alterados em grupos (NS, NPS e CSAT).</h1>\r\n          <br />\r\n          <h1>Cenário 1</h1>\r\n          <p>\"Quando selecionar o <strong>cenário 1</strong> você irá simular em um nível conservador. Ele poderá elevar ou reduzir em <strong>5% do seu NS realizado, NPS</strong> será simulado em 2% e o <strong>CSAT</strong> em 1%.<br />\r\n            <i>*O seu NS planejado no quadro de acompanhamento da sua simulação não sofrerá alteração.\"</i></p>\r\n          <br />\r\n          <h1>Cenário 2</h1>\r\n          <p>\"Quando selecionar o <strong>cenário 1</strong> você irá simular em um nível conservador. Ele poderá elevar ou reduzir em <strong>10% do seu NS realizado, NPS</strong> será simulado em 4% e o <strong>CSAT</strong> em 2%.<br />\r\n            <i>O seu NS planejado no quadro de acompanhamento da sua simulação não sofrerá alteração.\"</i></p>\r\n          <br />\r\n          <h1>Cenário 3</h1>\r\n          <p>\"Quando selecionar o <strong>cenário 1</strong> você irá simular em um nível conservador. Ele poderá elevar ou reduzir em <strong>15% do seu NS realizado, NPS</strong> será simulado em 6% e o <strong>CSAT</strong> em 3%.<br />\r\n            <i>*O seu NS planejado no quadro de acompanhamento da sua simulação não sofrerá alteração.\"</i></p>\r\n        </section>\r\n      </ContainerStyled>\r\n    </Content>\r\n  )\r\n}\r\nfunction OrientacaoDefault() {\r\n  return (\r\n    <Content titulo=\"Orientação\">\r\n      <ContainerStyled>\r\n        <section>\r\n        </section>\r\n      </ContainerStyled>\r\n    </Content>\r\n  )\r\n}","D:\\dev\\02. VORTEXPRO\\vortexpro\\app\\src\\pages\\Simulador\\SimulatorOptions.tsx",["315"],"import React from 'react';\r\nimport { ItemDragType } from './ItemDragType';\r\nimport { useDrag, DragSourceMonitor, DragPreviewImage } from 'react-dnd';\r\nimport IconPreview from '../../assets/images/drag-chart.png';\r\n\r\nimport ChartDoughnut from '../../components/Chart/ChartDoughnut';\r\n\r\ninterface TypeDataChart {\r\n  titulo: string;\r\n  planejado: number;\r\n  realizado: number;\r\n  desvio: number;\r\n}\r\ninterface TypeProps {\r\n  dataChart: TypeDataChart[];\r\n  setDataChartSelected: Function;\r\n}\r\n\r\ninterface TypePropsChartDragItem {\r\n  data: TypeDataChart;\r\n  setDataChartSelected: Function;\r\n}\r\n\r\nfunction SimulatorOptions({ dataChart, setDataChartSelected }: TypeProps) {\r\n  return (\r\n    <section id=\"simulator-options\">\r\n      <h3>Selecione e arraste um indicador:</h3>\r\n      <div className=\"grid-chart one-collum\">\r\n        {dataChart.map((item: TypeDataChart) => (\r\n          <ChartDragItem\r\n            key={item.titulo}\r\n            data={item}\r\n            setDataChartSelected={setDataChartSelected}\r\n          />\r\n        ))}\r\n      </div>\r\n    </section>\r\n  );\r\n}\r\n\r\nfunction ChartDragItem({ data, setDataChartSelected }: TypePropsChartDragItem) {\r\n  // FUNCTION DRAG AND DROP\r\n  const [{ isDragging }, drag, preview] = useDrag(() => ({\r\n    item: { titulo: data.titulo, type: ItemDragType.CHART },\r\n    end: (item: { titulo: string } | undefined, monitor: DragSourceMonitor) => {\r\n      const dropResult = monitor.getDropResult();\r\n      if (item && dropResult) {\r\n        setDataChartSelected(item.titulo);\r\n      }\r\n    },\r\n    collect: (monitor) => ({\r\n      isDragging: monitor.isDragging(),\r\n      handlerId: monitor.getHandlerId(),\r\n    }),\r\n  }));\r\n  const opacity = isDragging ? 0.4 : 1;\r\n\r\n  return (\r\n    <>\r\n      <DragPreviewImage connect={preview} src={IconPreview} />\r\n      <div\r\n        ref={drag}\r\n        role=\"Chart\"\r\n        data-id={data.titulo}\r\n        style={{ opacity }}\r\n        className=\"chart-item-drag\"\r\n      >\r\n        <ChartDoughnut\r\n          title={data.titulo}\r\n          desvio={data.desvio}\r\n          dataX={[data.planejado, data.realizado]}\r\n          label={['Planejado', 'Realizado']}\r\n        />\r\n      </div>\r\n      {/* versao mobile */}\r\n      <div\r\n        style={{ opacity }}\r\n        className=\"chart-item-select\"\r\n        onClick={() => {\r\n          setDataChartSelected(data.titulo);\r\n        }}\r\n      >\r\n        <h3>{data.titulo}</h3>\r\n        <span>\r\n          Desvio <br />\r\n          <h4>{data.desvio}</h4>\r\n        </span>\r\n        <span>\r\n          Planejado\r\n          <br />\r\n          <h4>{data.planejado}</h4>\r\n        </span>\r\n        <span>\r\n          Realizado\r\n          <br />\r\n          <h4>{data.realizado}</h4>\r\n        </span>\r\n      </div>\r\n    </>\r\n  );\r\n}\r\n\r\nexport default SimulatorOptions;\r\n","D:\\dev\\02. VORTEXPRO\\vortexpro\\app\\src\\helpers\\Alert.tsx",[],"D:\\dev\\02. VORTEXPRO\\vortexpro\\app\\src\\components\\Spinner\\index.tsx",[],"D:\\dev\\02. VORTEXPRO\\vortexpro\\app\\src\\components\\Chart\\ChartDoughnut.tsx",[],"D:\\dev\\02. VORTEXPRO\\vortexpro\\app\\src\\pages\\Simulador\\StyledComponents.tsx",[],"D:\\dev\\02. VORTEXPRO\\vortexpro\\app\\src\\pages\\Simulador\\ItemDragType.tsx",[],"D:\\dev\\02. VORTEXPRO\\vortexpro\\app\\src\\pages\\Permissionamento\\StyledComponents.tsx",[],"D:\\dev\\02. VORTEXPRO\\vortexpro\\app\\src\\services\\usuario.tsx",[],"D:\\dev\\02. VORTEXPRO\\vortexpro\\app\\src\\pages\\Home\\StyledComponents.tsx",[],"D:\\dev\\02. VORTEXPRO\\vortexpro\\app\\src\\pages\\ExcluirDados\\index.tsx",["316","317","318","319"],"import React, { useState, useEffect, ChangeEvent } from 'react';\r\nimport { NavLink, useHistory } from 'react-router-dom';\r\nimport Alert from '../../helpers/Alert';\r\nimport Select from '../../components/Form/Select';\r\n\r\nimport Spinner from '../../components/Spinner';\r\nimport swal from 'sweetalert';\r\n\r\n// serviços\r\nimport { retornaUsuarioLogado } from '../../services/usuario'\r\nimport { listaOperacoes } from '../../services/operacao';\r\nimport { deleteData } from '../../services/resultado';\r\nimport Input from '../../components/Form/Input';\r\n\r\ninterface TypeCombo {\r\n  _id: string;\r\n  nome: string;\r\n}\r\ninterface TypePeriodo {\r\n  dtInicio: string,\r\n  dtFim: string,\r\n}\r\n\r\nexport default function ExcluirDados() {\r\n  const [spinnerStatus, setSpinnerStatus] = useState<boolean>(false);\r\n  const [operacaoSelected, setOperacaoSelected] = useState<string>('');\r\n  const [operacoes, setOperacoes] = useState<TypeCombo[]>([]);\r\n\r\n  const [periodoSelected, setPeriodoSelected] = useState<TypePeriodo>({\r\n    dtInicio: '',\r\n    dtFim: ''\r\n  });\r\n\r\n\r\n  useEffect(() => {\r\n\r\n    try {\r\n\r\n      // busca lista de operações\r\n      listaOperacoes()\r\n        .then((res) => {\r\n          const dataResponse = res.data.operacao.map(\r\n            ({ _id, nome, celula }: any) => {\r\n              return { _id, nome: `${nome} - ${celula}` };\r\n            }\r\n          );\r\n          setOperacoes(dataResponse);\r\n        })\r\n        .catch((err) => {\r\n          console.log(err);\r\n        });\r\n\r\n      //set o periodo com a data atual\r\n      const today = new Date();\r\n      const dd = String(today.getDate()).padStart(2, '0');\r\n      const mm = String(today.getMonth() + 1).padStart(2, '0'); //January is 0!\r\n      const yyyy = today.getFullYear();\r\n\r\n      setPeriodoSelected({ dtFim: `${yyyy}-${mm}-${dd}`, dtInicio: `${yyyy}-${mm}-${dd}` })\r\n\r\n    } catch (error) {\r\n      console.log(error)\r\n    }\r\n\r\n  }, []);\r\n\r\n  const handleSubmitDelete = (event: ChangeEvent<HTMLFormElement>) => {\r\n    event.preventDefault();\r\n    setSpinnerStatus(true);\r\n\r\n    deleteData(operacaoSelected, periodoSelected.dtInicio, periodoSelected.dtFim)\r\n      .then((res) => {\r\n        setSpinnerStatus(false);\r\n        Alert(true, \"Dados excluidos com sucesso!\")\r\n      })\r\n      .catch((err) => {\r\n        Alert(\r\n          false,\r\n          err?.response?.data?.error\r\n            ? err.response.data.error\r\n            : 'Erro ao excluir os dados'\r\n        );\r\n        setSpinnerStatus(false);\r\n      });\r\n  }\r\n\r\n  const handlePeriodoChange = (event: ChangeEvent<HTMLInputElement>) => {\r\n    const { name, value } = event.target;\r\n\r\n    if (name === 'dtInicio' && value > periodoSelected.dtFim) {\r\n      Alert(false, \"A Data Inicial precisa ser menor que a Data Final\")\r\n    } else if (name === 'dtFim' && value < periodoSelected.dtInicio) {\r\n      Alert(false, \"A Data Final precisa ser maior que a Data Inicial\")\r\n    } else {\r\n      setPeriodoSelected({ ...periodoSelected, [name]: value });\r\n    }\r\n  };\r\n\r\n  return (\r\n    <>\r\n      <Spinner active={spinnerStatus} />\r\n      <div className=\"fieldset\">\r\n\r\n        <form onSubmit={handleSubmitDelete}>\r\n          <Input\r\n            name=\"dtInicio\"\r\n            label=\"Data Inicial\"\r\n            type=\"date\"\r\n            data={periodoSelected.dtInicio}\r\n            setData={handlePeriodoChange}\r\n            required={true}\r\n          />\r\n          <Input\r\n            name=\"dtFim\"\r\n            label=\"Data Final\"\r\n            type=\"date\"\r\n            data={periodoSelected.dtFim}\r\n            setData={handlePeriodoChange}\r\n            required={true}\r\n          />\r\n          <Select\r\n            title=\"operação\"\r\n            data={operacoes}\r\n            value={operacaoSelected}\r\n            setSelected={setOperacaoSelected}\r\n            required={true}\r\n          />\r\n          <div className=\"field\">\r\n            <button className=\"button warning\">Excluir de dados</button>\r\n          </div>\r\n        </form>\r\n      </div>\r\n\r\n    </>\r\n  );\r\n}\r\n","D:\\dev\\02. VORTEXPRO\\vortexpro\\app\\src\\components\\Content\\styles.tsx",[],"D:\\dev\\02. VORTEXPRO\\vortexpro\\app\\src\\pages\\Simulador\\index.tsx",["320","321","322","323","324","325","326","327"],"import React, { useState, useEffect, ChangeEvent } from 'react';\r\nimport { DndProvider } from 'react-dnd';\r\nimport { HTML5Backend } from 'react-dnd-html5-backend';\r\n\r\n\r\n// COMPONENTS\r\nimport Spinner from '../../components/Spinner';\r\nimport Header from '../../components/Header';\r\nimport Content from '../../components/Content';\r\nimport GridResults from './GridResults';\r\nimport { Simulator, FilterSimulator } from './StyledComponents';\r\nimport SimulatorOptions from './SimulatorOptions';\r\nimport SimulatorSelected from './SimulatorSelected';\r\nimport Select from '../../components/Form/Select';\r\nimport Input from '../../components/Form/Input';\r\n\r\n// SERVICES\r\nimport { listData, detailData } from '../../services/resultado';\r\nimport { simularArima, simularTMO, simularNPS, simularNS, simularCSAT } from '../../services/simulador';\r\nimport { listaOperacoes } from '../../services/operacao';\r\nimport Alert from '../../helpers/Alert';\r\n\r\nimport ParamsSimulador from '../../helpers/ParamsSimulador.json'\r\n\r\n//#region TYPES\r\ninterface TypeDataChart {\r\n  titulo: string;\r\n  planejado: number;\r\n  realizado: number;\r\n  replanejado: number;\r\n  desvio: number;\r\n}\r\ninterface TypeDataChartBar {\r\n  label: string[];\r\n  kpi_csat_p: number[];\r\n  kpi_csat_r: number[];\r\n  kpi_nps_p: number[];\r\n  kpi_nps_r: number[];\r\n  kpi_ns_p: number[];\r\n  kpi_ns_r: number[];\r\n  kpi_pa_hc_p: number[];\r\n  kpi_pa_hc_r: number[];\r\n  kpi_tmo_p: number[];\r\n  kpi_tmo_r: number[];\r\n  kpi_volume_p: number[];\r\n  kpi_volume_r: number[];\r\n}\r\ninterface TypeData {\r\n  periodo: string;\r\n  kpi_nps: number;\r\n  kpi_nps_p: number;\r\n  kpi_nps_r: number;\r\n  kpi_nps_desvio: number;\r\n  kpi_csat: number;\r\n  kpi_csat_p: number;\r\n  kpi_csat_r: number;\r\n  kpi_csat_desvio: number;\r\n  kpi_pa_hc: number;\r\n  kpi_pa_hc_p: number;\r\n  kpi_pa_hc_r: number;\r\n  kpi_pa_hc_desvio: number;\r\n  kpi_volume: number;\r\n  kpi_volume_p: number;\r\n  kpi_volume_r: number;\r\n  kpi_volume_desvio: number;\r\n  kpi_tmo: number;\r\n  kpi_tmo_p: number;\r\n  kpi_tmo_r: number;\r\n  kpi_tmo_desvio: number;\r\n  kpi_ns: number;\r\n  kpi_ns_p: number;\r\n  kpi_ns_r: number;\r\n  kpi_ns_desvio: number;\r\n}\r\ninterface TypeCombo {\r\n  _id: string;\r\n  nome: string;\r\n}\r\ninterface TypePeriodo {\r\n  dtInicio: string,\r\n  dtFim: string,\r\n}\r\n//#endregion\r\n\r\n\r\nexport default function Simulador({ location }: any) {\r\n\r\n  // VARIAVEL PARA RESETAR OBJETO\r\n  const emptyDataChartBar: TypeDataChartBar = {\r\n    label: [],\r\n    kpi_csat_p: [],\r\n    kpi_csat_r: [],\r\n    kpi_nps_p: [],\r\n    kpi_nps_r: [],\r\n    kpi_ns_p: [],\r\n    kpi_ns_r: [],\r\n    kpi_pa_hc_p: [],\r\n    kpi_pa_hc_r: [],\r\n    kpi_tmo_p: [],\r\n    kpi_tmo_r: [],\r\n    kpi_volume_p: [],\r\n    kpi_volume_r: [],\r\n  };\r\n\r\n  // SPINNER /LOAD\r\n  const [spinnerStatus, setSpinnerStatus] = useState<boolean>(false);\r\n\r\n  //#region OPÇÕES DO SIMULADOR\r\n  // DADOS PARA GRÁFICOS DE OPÇÕES\r\n  const [dataChart, setDataChart] = useState<TypeDataChart[]>([]);\r\n\r\n  // GRÁFICO SELECIONADO NAS OPÇÕES\r\n  const [dataChartSelected, setDataChartSelected] = useState<string>('');\r\n\r\n  // BUSCA DADOS PARA GRÁFICOS DE OPÇÕES\r\n  useEffect(() => {\r\n    //set o periodo com a data atual\r\n    const today = new Date();\r\n    const dd = String(today.getDate()).padStart(2, '0');\r\n    const mm = String(today.getMonth() + 1).padStart(2, '0'); //January is 0!\r\n    const yyyy = today.getFullYear();\r\n\r\n    try {\r\n      setSpinnerStatus(true);\r\n      const filtros = localStorage.getItem('filtros')\r\n      const filtrosParse = JSON.parse(filtros || '');\r\n      const { operacao, dtInicio, dtFim } = filtrosParse\r\n      console.log(operacao)\r\n      if (operacao) {\r\n        setPeriodoSelected({ dtInicio, dtFim })\r\n        setOperacaoSelected(operacao)\r\n        getData(operacao, dtInicio, dtFim)\r\n      } else {\r\n        setPeriodoSelected({ dtFim: `${yyyy}-${mm}-${dd}`, dtInicio: `${yyyy}-${mm}-${dd}` })\r\n        setSpinnerStatus(false);\r\n      }\r\n    } catch (error) {\r\n      setPeriodoSelected({ dtFim: `${yyyy}-${mm}-${dd}`, dtInicio: `${yyyy}-${mm}-${dd}` })\r\n      setSpinnerStatus(false);\r\n    }\r\n  }, []);\r\n  //#endregion \r\n\r\n\r\n  //#region FILTROS\r\n\r\n  // LISTA DE OPERAÇÕES PARA FILTRO\r\n  const [operacoes, setOperacoes] = useState<TypeCombo[]>([]);\r\n\r\n  //OPERAÇÃO SELECIONADA NO FILTRO\r\n  const [operacaoSelected, setOperacaoSelected] = useState<string>('');\r\n\r\n  // PERIODO SELECIONADO NO FILTRO\r\n  const [periodoSelected, setPeriodoSelected] = useState<TypePeriodo>({\r\n    dtInicio: '',\r\n    dtFim: ''\r\n  });\r\n\r\n  // BUSCA A LISTA DE OPERAÇÕES DO USUARIO\r\n  useEffect(() => {\r\n    listaOperacoes()\r\n      .then((res) => {\r\n        const dataResponse = res.data.operacao.map(\r\n          ({ _id, nome, celula }: any) => {\r\n            return { _id, nome: `${nome} - ${celula}` };\r\n          }\r\n        );\r\n        setOperacoes(dataResponse);\r\n      })\r\n      .catch((err) => {\r\n        console.log(err);\r\n      });\r\n\r\n  }, []);\r\n  //#endregion\r\n\r\n\r\n  //#region BUSCAR INFORMAÇÕES DOS FILTROS\r\n  // DADOS FILTRADOS\r\n  const [fullData, setFullData] = useState<TypeData>();\r\n  const [fullMonthlyData, setFullMonthlyData] = useState<TypeData[]>();\r\n\r\n  // BUSCA OS DADOS DO FILTRO REALIZADO\r\n  const getData = async (operacao: string, dtInicio: string, dtFim: string) => {\r\n\r\n    try {\r\n      setDataChartBar({ ...emptyDataChartBar })\r\n      setDataChartSelected('')\r\n\r\n      // BUSCA OS DADOS CONSOLIDADOS DO PERIODO\r\n      const responseDataCons = await listData(operacao, 'consolidado', dtInicio, dtFim);\r\n      const data_cons = responseDataCons.data[0];\r\n      setFullData(data_cons);\r\n\r\n      // BUSCA OS DADOS CONSOLIDADOS POR MÊS\r\n      const responseDataMonthly = await listData(operacao, 'mes', dtInicio, dtFim);\r\n      setFullMonthlyData(responseDataMonthly.data);\r\n\r\n      // FORMATA O DADO PARA EXIBIR NOS GRAFICOS DE INDICADORES\r\n      const newDataChart: TypeDataChart[] = [];\r\n      newDataChart.push({\r\n        titulo: '% NS',\r\n        planejado: data_cons.kpi_ns_p,\r\n        realizado: data_cons.kpi_ns,\r\n        replanejado: data_cons.kpi_ns_r,\r\n        desvio: data_cons.kpi_ns_desvio,\r\n      });\r\n      newDataChart.push({\r\n        titulo: 'NPS',\r\n        planejado: data_cons.kpi_nps_p,\r\n        realizado: data_cons.kpi_nps,\r\n        replanejado: data_cons.kpi_nps_r,\r\n        desvio: data_cons.kpi_nps_desvio,\r\n      });\r\n      newDataChart.push({\r\n        titulo: 'CSAT',\r\n        planejado: data_cons.kpi_csat_p,\r\n        realizado: data_cons.kpi_csat,\r\n        replanejado: data_cons.kpi_csat_r,\r\n        desvio: data_cons.kpi_csat_desvio,\r\n      });\r\n\r\n      setDataChart(newDataChart);\r\n\r\n      // CAPTURA INFORMAÇÕES OS DADOS RETORNADOS PARA EXIBIR NO ALERTA\r\n      const responseDetalhes = await detailData(operacao, dtInicio, dtFim)\r\n      let { minData, maxData } = responseDetalhes.data[0];\r\n      minData = new Date(minData).toLocaleDateString('pt-BR', { timeZone: 'UTC' });\r\n      maxData = new Date(maxData).toLocaleDateString('pt-BR', { timeZone: 'UTC' });\r\n      Alert(true, `Dados de ${minData} até ${maxData}`);\r\n\r\n      setSpinnerStatus(false);\r\n    } catch (err) {\r\n      Alert(\r\n        false,\r\n        err?.response?.data?.error\r\n          ? err.response.data.error\r\n          : 'Sem dados para apresentar'\r\n      );\r\n      setSpinnerStatus(false);\r\n    };\r\n  }\r\n\r\n  //#endregion\r\n\r\n  // DADOS PARA GRÁFICOS DA SIMULAÇÃO\r\n  const [dataChartBar, setDataChartBar] = useState<TypeDataChartBar>({\r\n    ...emptyDataChartBar,\r\n  });\r\n\r\n  // BUSCA INFORMAÇÕES DA SIMULAÇÃO DE PERCENTUAL\r\n\r\n  const simulate = async (factor: number, qtyMonths: number) => {\r\n\r\n    setDataChartBar({ ...emptyDataChartBar });\r\n    setSpinnerStatus(true);\r\n\r\n    try {\r\n      if (fullMonthlyData && fullData) {\r\n\r\n        const newDataChartBar: TypeDataChartBar = { ...emptyDataChartBar };\r\n\r\n        const params = ParamsSimulador.filter(a => a.fator === factor && a.indicador === dataChartSelected)\r\n        const { perc } = params[0];\r\n\r\n        // REPROJEÇÃO DO TMO\r\n        const tmoResponse = await simularTMO(fullData?.kpi_tmo || 0, perc, qtyMonths);\r\n        tmoResponse.data.map((item: any) => {\r\n          newDataChartBar?.kpi_tmo_r.push(Math.round(item));\r\n        })\r\n        // REPROJEÇÃO DO NS\r\n        const nsResponse = await simularNS(fullData?.kpi_ns || 0, perc, qtyMonths);\r\n        nsResponse.data.map((item: any) => {\r\n          newDataChartBar?.kpi_ns_r.push(item.toFixed(2));\r\n        })\r\n        // REPROJEÇÃO DO CSAT\r\n        const csatResponse = await simularCSAT(fullData?.kpi_csat || 0, perc, qtyMonths);\r\n        csatResponse.data.map((item: any) => {\r\n          newDataChartBar?.kpi_csat_r.push(Math.round(item));\r\n        })\r\n        // REPROJEÇÃO DO NPS\r\n        const npsResponse = await simularNPS(fullData?.kpi_nps || 0, perc, qtyMonths);\r\n        npsResponse.data.map((item: any) => {\r\n          newDataChartBar?.kpi_nps_r.push(item.toFixed(2));\r\n        })\r\n\r\n        // REPROJEÇÃO RECEBIDAS COM ARIMA\r\n        const recebidasArray = fullMonthlyData.map((res: TypeData) => {\r\n          return {\r\n            periodo: res.periodo,\r\n            result: res.kpi_volume\r\n          }\r\n        })\r\n\r\n        const responseRecebida = await simularArima(recebidasArray, qtyMonths)\r\n        responseRecebida.data.map((item: any) => {\r\n          newDataChartBar?.kpi_volume_r.push(Math.round(item));\r\n        })\r\n\r\n\r\n        // VARIAVEIS PARA GERAR MESES FUTUROS - LABEL\r\n        const lastMonth = fullMonthlyData[fullMonthlyData.length - 1]\r\n        const periodoSplit = lastMonth.periodo.split('/');\r\n        let month = periodoSplit[0];\r\n        let year = periodoSplit[1];\r\n\r\n        // PARAMETROS PROJEÇÃO\r\n        const dtIniProjecao = new Date(Number(periodoSplit[1]), Number(periodoSplit[0]), 1)\r\n        const dtFimProjecao = new Date(Number(periodoSplit[1]), Number(periodoSplit[0]) + qtyMonths, 1)\r\n        dtFimProjecao.setDate(dtFimProjecao.getDate() - 1);\r\n\r\n        // BUSCA INFORMAÇÕES DOS MESES FUTURO PARA PROJEÇÃO\r\n        const responseProjecao = await listData(operacaoSelected, 'mes', dtIniProjecao.toISOString().slice(0, 10), dtFimProjecao.toISOString().slice(0, 10));\r\n\r\n        // GERA OS PROXIMOS MESES\r\n        for (let i = 0; i < qtyMonths; i++) {\r\n          if (month === '12') {\r\n            year = String(parseInt(year) + 1);\r\n            month = '1';\r\n          } else {\r\n            month = String(parseInt(month) + 1);\r\n          }\r\n          newDataChartBar?.label.push(`${month}/${year}`);\r\n\r\n          // HC NAO TEM REPROJEÇAO E REPLICA O RESULTADO ATUAL\r\n          newDataChartBar?.kpi_pa_hc_r.push(fullData.kpi_pa_hc_r);\r\n\r\n          // CARREGA OS DADOS PROJETADOS\r\n          if (i < responseProjecao.data.length && responseProjecao) {\r\n            const dataProjecao = responseProjecao.data[i]\r\n            const { kpi_pa_hc_p, kpi_tmo_p, kpi_ns_p, kpi_csat_p, kpi_nps_p, kpi_volume_p } = dataProjecao;\r\n            newDataChartBar?.kpi_pa_hc_p.push(kpi_pa_hc_p || 0);\r\n            newDataChartBar?.kpi_tmo_p.push(Math.round(kpi_tmo_p || 0));\r\n            newDataChartBar?.kpi_ns_p.push(Math.round(kpi_ns_p || 0));\r\n            newDataChartBar?.kpi_csat_p.push(Math.round(kpi_csat_p || 0));\r\n            newDataChartBar?.kpi_nps_p.push(Math.round(kpi_nps_p || 0));\r\n            newDataChartBar?.kpi_volume_p.push(Math.round(kpi_volume_p || 0));\r\n          } else {\r\n            newDataChartBar?.kpi_pa_hc_p.push(0);\r\n            newDataChartBar?.kpi_tmo_p.push(0);\r\n            newDataChartBar?.kpi_ns_p.push(0);\r\n            newDataChartBar?.kpi_csat_p.push(0);\r\n            newDataChartBar?.kpi_nps_p.push(0);\r\n            newDataChartBar?.kpi_volume_p.push(0);\r\n          }\r\n        }\r\n\r\n        setDataChartBar(newDataChartBar);\r\n        setSpinnerStatus(false);\r\n      }\r\n    } catch (err) {\r\n      setSpinnerStatus(false);\r\n    };\r\n  };\r\n\r\n\r\n  // FILTRA INFORMAÇÕES\r\n  const filterData = (event: ChangeEvent<HTMLFormElement>) => {\r\n    event.preventDefault();\r\n    if (periodoSelected.dtInicio > periodoSelected.dtFim && periodoSelected.dtFim != '') {\r\n      Alert(false, \"A Data Inicial precisa ser menor que a Data Final\")\r\n    } else if (periodoSelected.dtFim < periodoSelected.dtInicio && periodoSelected.dtInicio && periodoSelected.dtFim != '') {\r\n      Alert(false, \"A Data Final precisa ser maior que a Data Inicial\")\r\n    } else {\r\n      const param_filtros = { operacao: operacaoSelected, dtInicio: periodoSelected.dtInicio, dtFim: periodoSelected.dtFim }\r\n      localStorage.setItem(`filtros`, JSON.stringify(param_filtros));\r\n\r\n      getData(operacaoSelected, periodoSelected.dtInicio, periodoSelected.dtFim)\r\n    }\r\n  };\r\n\r\n  // VALIDAÇÃO DO PERIODO FILTRADO\r\n  const handlePeriodoChange = (event: ChangeEvent<HTMLInputElement>) => {\r\n    const { name, value } = event.target;\r\n    setPeriodoSelected({ ...periodoSelected, [name]: value });\r\n  };\r\n\r\n\r\n  return (\r\n    <>\r\n      <Spinner active={spinnerStatus} />\r\n      <Header />\r\n      <Content titulo=\"Simulador \" >\r\n        <div id='capture'>\r\n          <FilterSimulator>\r\n            <form onSubmit={filterData}>\r\n              <div className=\"field\">\r\n                <h3>Filtros:</h3>\r\n              </div>\r\n              <Input\r\n                name=\"dtInicio\"\r\n                label=\"Data Inicial\"\r\n                type=\"date\"\r\n                data={periodoSelected.dtInicio}\r\n                setData={handlePeriodoChange}\r\n                required={true}\r\n              />\r\n              <Input\r\n                name=\"dtFim\"\r\n                label=\"Data Final\"\r\n                type=\"date\"\r\n                data={periodoSelected.dtFim}\r\n                setData={handlePeriodoChange}\r\n                required={true}\r\n              />\r\n              <Select\r\n                title=\"operação\"\r\n                data={operacoes}\r\n                value={operacaoSelected}\r\n                setSelected={setOperacaoSelected}\r\n                required={true}\r\n              />\r\n              <div className=\"field\">\r\n                <button className=\"button\">Filtrar</button>\r\n              </div>\r\n            </form>\r\n            <hr />\r\n          </FilterSimulator>\r\n          <Simulator>\r\n            <DndProvider backend={HTML5Backend}>\r\n\r\n              <SimulatorOptions\r\n                dataChart={dataChart}\r\n                setDataChartSelected={setDataChartSelected}\r\n              />\r\n\r\n              <SimulatorSelected\r\n                dataChartSelected={dataChartSelected}\r\n                dataChart={dataChart}\r\n                simulate={simulate}\r\n              />\r\n\r\n            </DndProvider>\r\n            <GridResults dataChartBar={dataChartBar} />\r\n          </Simulator>\r\n        </div>\r\n\r\n      </Content>\r\n    </>\r\n  );\r\n}\r\n","D:\\dev\\02. VORTEXPRO\\vortexpro\\app\\src\\pages\\Dashboard\\StyledDashboard.tsx",[],"D:\\dev\\02. VORTEXPRO\\vortexpro\\app\\src\\pages\\GerenciarOperacoes\\StyledComponents.tsx",[],"D:\\dev\\02. VORTEXPRO\\vortexpro\\app\\src\\pages\\GerenciarOperacoes\\index.tsx",["328","329"],"import React, { useState, useEffect, ChangeEvent } from 'react';\r\nimport { NavLink, useHistory } from 'react-router-dom';\r\nimport { AdminStyled } from './StyledComponents'\r\n\r\nimport { listaOperacoes, deletaOperacao, cadastrarOperacao } from '../../services/operacao';\r\n\r\nimport Input from '../../components/Form/Input';\r\nimport Alert from '../../helpers/Alert';\r\n\r\ninterface TypeData {\r\n  operacao: string;\r\n  celula: string;\r\n}\r\n\r\nexport default function GerenciarOperacoes() {\r\n  const [novaOperacao, setNovaOperacao] = useState<TypeData>({ operacao: '', celula: '' });\r\n\r\n  const [operacoes, setOperacoes] = useState<any[]>([]);\r\n  let history = useHistory();\r\n\r\n  useEffect(() => {\r\n    buscarOperacoes()\r\n  }, [])\r\n\r\n  const buscarOperacoes = () => {\r\n    listaOperacoes().then(res => {\r\n      setOperacoes(res.data.operacao)\r\n    }).catch(err => {\r\n      history.push('/Home');\r\n    })\r\n  }\r\n  const excluirCelula = (id: string) => {\r\n    deletaOperacao(id).then(res => {\r\n      Alert(true, 'Célula excluida com sucesso!');\r\n      buscarOperacoes()\r\n    }).catch(err => {\r\n      Alert(false, 'Ocorreu um erro ao excluir a célula!')\r\n    })\r\n  }\r\n\r\n\r\n  const handleInputChange = (event: ChangeEvent<HTMLInputElement>) => {\r\n    const { name, value } = event.target;\r\n    setNovaOperacao({ ...novaOperacao, [name]: value });\r\n  };\r\n\r\n  const handleSubmit = (event: ChangeEvent<HTMLFormElement>) => {\r\n    event.preventDefault();\r\n\r\n    const usuario = localStorage.getItem('usuario');\r\n    const usuarioJson = JSON.parse(usuario || '')\r\n\r\n    cadastrarOperacao({\r\n      nome: novaOperacao.operacao,\r\n      celula: novaOperacao.celula,\r\n      id_usuario: usuarioJson._id,\r\n    }).then(res => {\r\n      buscarOperacoes()\r\n    }).catch(err => {\r\n      Alert(false, \"Ocorreu um erro ao cadastrar célula!\")\r\n      history.push('/login')\r\n    })\r\n  };\r\n  return (\r\n    <>\r\n      <div className=\"fieldset\">\r\n        <div className=\"field\">\r\n          <h3>Cadastrar operação/célula</h3>\r\n        </div>\r\n\r\n        <form onSubmit={handleSubmit}>\r\n          <Input\r\n            name=\"operacao\"\r\n            label=\"Operação\"\r\n            type=\"text\"\r\n            placeholder={'Digite o nome da operação'}\r\n            data={novaOperacao.operacao}\r\n            setData={handleInputChange}\r\n            required={true}\r\n          />\r\n          <Input\r\n            name=\"celula\"\r\n            label=\"Sub-operacao\"\r\n            type=\"text\"\r\n            placeholder={'Digite o nome da célula'}\r\n            data={novaOperacao.celula}\r\n            setData={handleInputChange}\r\n            required={true}\r\n          />\r\n          <div className=\"field\">\r\n            <button className=\"button\">Cadastrar Operação</button>\r\n          </div>\r\n        </form>\r\n      </div>\r\n      <div className=\"fieldset\">\r\n        <div className=\"field\">\r\n          <h3>Excluir operação/célula</h3>\r\n        </div>\r\n        <AdminStyled>\r\n          <table className='table'>\r\n            <thead>\r\n              <tr>\r\n                <td>Operação</td>\r\n                <td>Célula</td>\r\n                <td>-</td>\r\n              </tr>\r\n            </thead>\r\n            <tbody>\r\n              {operacoes.map((res, _) =>\r\n                <tr key={res._id}>\r\n                  <td>{res.nome}</td>\r\n                  <td>{res.celula}</td>\r\n                  <td>\r\n                    <div className=\"field\">\r\n                      <button className='button warning' onClick={() => { excluirCelula(res._id) }}>Excluir Célula</button>\r\n                    </div>\r\n                  </td>\r\n                </tr>\r\n              )}\r\n            </tbody>\r\n          </table>\r\n        </AdminStyled>\r\n      </div>\r\n    </>\r\n  );\r\n}\r\n","D:\\dev\\03. TELL-M\\tell-m-frontend\\src\\App.tsx",[],"D:\\dev\\03. TELL-M\\tell-m-frontend\\src\\services\\usuario.tsx",[],"D:\\dev\\03. TELL-M\\tell-m-frontend\\src\\services\\operacao.tsx",[],"D:\\dev\\03. TELL-M\\tell-m-frontend\\src\\services\\resultado.tsx",[],"D:\\dev\\03. TELL-M\\tell-m-frontend\\src\\services\\simulador.tsx",[],"D:\\dev\\03. TELL-M\\tell-m-frontend\\src\\index.tsx",[],"D:\\dev\\03. TELL-M\\tell-m-frontend\\src\\pages\\Login\\index.tsx",[],["330","331"],"D:\\dev\\03. TELL-M\\tell-m-frontend\\src\\routes.tsx",["332"],"D:\\dev\\03. TELL-M\\tell-m-frontend\\src\\config\\api.tsx",[],"D:\\dev\\03. TELL-M\\tell-m-frontend\\src\\pages\\Home\\index.tsx",["333"],{"ruleId":"334","severity":1,"message":"335","line":13,"column":8,"nodeType":"336","messageId":"337","endLine":13,"endColumn":16},{"ruleId":"338","replacedBy":"339"},{"ruleId":"340","replacedBy":"341"},{"ruleId":"338","replacedBy":"342"},{"ruleId":"340","replacedBy":"343"},{"ruleId":"334","severity":1,"message":"344","line":1,"column":27,"nodeType":"336","messageId":"337","endLine":1,"endColumn":36},{"ruleId":"334","severity":1,"message":"345","line":11,"column":10,"nodeType":"336","messageId":"337","endLine":11,"endColumn":26},{"ruleId":"346","severity":1,"message":"347","line":111,"column":15,"nodeType":"348","endLine":111,"endColumn":57},{"ruleId":"334","severity":1,"message":"349","line":6,"column":8,"nodeType":"336","messageId":"337","endLine":6,"endColumn":12},{"ruleId":"346","severity":1,"message":"347","line":90,"column":17,"nodeType":"348","endLine":90,"endColumn":97},{"ruleId":"338","replacedBy":"350"},{"ruleId":"340","replacedBy":"351"},{"ruleId":"352","severity":1,"message":"353","line":70,"column":6,"nodeType":"354","endLine":70,"endColumn":36,"suggestions":"355"},{"ruleId":"338","replacedBy":"356"},{"ruleId":"340","replacedBy":"357"},{"ruleId":"334","severity":1,"message":"358","line":1,"column":38,"nodeType":"336","messageId":"337","endLine":1,"endColumn":49},{"ruleId":"334","severity":1,"message":"359","line":3,"column":8,"nodeType":"336","messageId":"337","endLine":3,"endC